# Copy to .env.local and fill in the correct value for your environment.
# .env.local is git-ignored — never commit real values.
# NEXT_PUBLIC_* variables are embedded at build time by Next.js.

# ── Single-tunnel local / ngrok testing (recommended) ─────────────────────────
# Run only one ngrok tunnel on port 3000.  Next.js rewrites /api/* to the local
# backend at http://localhost:8080 so the browser never leaves the frontend origin.
NEXT_PUBLIC_API_URL=/api

# ── Direct backend URL (two-tunnel or remote backend) ─────────────────────────
# NEXT_PUBLIC_API_URL=https://your-backend.ngrok-free.app/api

# ── Production ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=https://api.example.com/api

# ── App version (optional) ───────────────────────────────────────────────────
# Shown in the UI footer. Injected by CI/CD as the git SHA or tag.
# NEXT_PUBLIC_APP_VERSION=dev
