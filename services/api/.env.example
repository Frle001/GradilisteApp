# Server
PORT=8080
ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=gradiliste
DB_PASSWORD=gradiliste_dev_password
DB_NAME=gradiliste

# JWT — required for authentication
# Generate a secure random string for production: openssl rand -base64 48
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Bcrypt cost (10 = fast dev, 12 = recommended production)
BCRYPT_COST=12

# AWS S3 (future — receipt image storage)
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
