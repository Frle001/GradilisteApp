# ── Runtime environment ────────────────────────────────────────────────────────
# APP_ENV: development | production
APP_ENV=development

# Application version — shown in /api/health response.
# Override via build ldflags: -ldflags="-X main.version=v1.2.3"
APP_VERSION=dev

# ── Server ─────────────────────────────────────────────────────────────────────
# SERVER_PORT is preferred. PORT is a fallback for platforms (Render, Railway) that set it.
SERVER_PORT=8080

# ── Database ───────────────────────────────────────────────────────────────────
# Option 1 — single connection string (Render, Fly.io, Railway, Heroku, Neon, Supabase)
# sslmode=require is injected automatically for remote hosts.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option 2 — individual vars (local Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=gradiliste
DB_PASSWORD=gradiliste_dev_password
DB_NAME=gradiliste

# ── JWT / Auth ──────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=your-secret-key-change-this-in-production
# Short-lived access tokens; refresh tokens extend sessions silently.
JWT_EXPIRES_IN=15m
BCRYPT_COST=12

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# REQUIRED in production — server will refuse to start if omitted.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# ── Cookie settings ─────────────────────────────────────────────────────────────
# COOKIE_SECURE: true = send cookie only over HTTPS. Defaults to true outside development.
# COOKIE_SAME_SITE: lax (default) | none | strict
#   Set "none" + COOKIE_SECURE=true when the frontend (Vercel) and backend (Render) are
#   on different HTTPS origins — required for cross-origin HttpOnly cookies.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# ── File storage ────────────────────────────────────────────────────────────────
# UPLOAD_STORAGE_DRIVER: local | s3
# Use "s3" in production with Cloudflare R2 — local storage is lost on container restart.
UPLOAD_STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Cloudflare R2 / S3 storage ──────────────────────────────────────────────────
# Required when UPLOAD_STORAGE_DRIVER=s3. Obtain from Cloudflare R2 dashboard.
# S3_ENDPOINT: Account-level R2 endpoint — https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET: Bucket name (must already exist in R2)
# S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY: R2 API token (not your Cloudflare account key)
# S3_USE_PATH_STYLE: must be "true" for Cloudflare R2
# S3_PUBLIC_BASE_URL: optional — public URL prefix if bucket has public access enabled
#   (leave empty to always serve receipts through the API, which enforces auth)
# S3_REGION: leave as "auto" for Cloudflare R2
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=gradiliste-receipts
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_USE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=

# ── Logging ─────────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug
